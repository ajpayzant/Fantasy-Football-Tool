__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Local database + generated artifacts (rebuildable)
data/*.db
data/*.db-journal
data/*.db-shm
data/*.db-wal
data/*.sqlite
data/exports/
*.log

# Fetched provider payloads. Rebuildable from the network in seconds, and stale
# within half a day, so committing them would only ever ship someone else's old
# ADP. The recorded fixtures under tests/ are deliberately NOT ignored — those
# are pinned test inputs, not a cache.
data/cache/
.scratch/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Test / tooling caches
.pytest_cache/
.coverage
htmlcov/
.streamlit/secrets.toml

# Local Streamlit config. Deliberately NOT committed: Streamlit Community Cloud
# assigns the port itself, and a committed `server.port` makes the deployed app
# bind to the wrong one, so it never answers the health check and Cloud reports a
# bare "Error running app" with nothing in the log. The port belongs to
# launch_mock_draft.bat, which passes it explicitly. See the README.
.streamlit/config.toml
